# Popofiler Configuration
# Copy this file to .env and update with your actual values

# Kubernetes Configuration
K8S_CONTEXT=your_k8s_context_here
NAMESPACE=your_namespace_here

# Pod Selection Configuration  
PROJECT_NAME=your_project_name_here
POD_NAME_ANTI_PATTERN=your_pod_name_anti_pattern_here

# Security Note:
# - Never commit .env files containing real credentials
# - Use specific, restricted Kubernetes contexts when possible
# - Regularly rotate any credentials used